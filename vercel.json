{
  "version": 2,
  "builds": [
    { "src": "main.py", "use": "@vercel/python" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "main.py" },
    { "src": "/models/(.*)", "dest": "main.py" },
    { "src": "/(.*)", "dest": "/frontend/index.htm" }
  ],
  "functions": {
    "main.py": { "maxDuration": 60 }
  }
}
